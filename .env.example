# URL del backend HTTP — se bakea en el bundle del cliente en build time.
# Local sin Docker:  http://localhost:3001
# Local con proxy Next.js (rewrites): http://localhost:3000
# Producción:        https://pay-alert-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL WebSocket del backend — SEPARADA porque Next.js rewrites no proxean WS.
# Local:       ws://localhost:3001
# Producción:  wss://pay-alert-api.onrender.com
# Si no se define, se deriva de NEXT_PUBLIC_API_URL (funciona en prod, falla en local con proxy).
NEXT_PUBLIC_WS_URL=ws://localhost:3001
