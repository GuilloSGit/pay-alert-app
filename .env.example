# URL del backend — server-side, NO se expone al bundle del cliente.
# Next.js rewrites proxean /api/v1/* hacia esta URL en el servidor.
#
# Local sin Docker:  http://localhost:3001
# Local con Docker:  http://pay-alert-api:3001  (nombre del servicio en docker-compose)
# Producción:        https://api.pay-alert.com.ar  (o la URL del servicio en Render)
API_URL=http://localhost:3001
